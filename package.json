  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cantoo/pdf-lib": "^2.11.1",
    "@eslint/js": "^10.0.1",
    "@fontsource/martian-mono": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "exifr": "^7.1.3",
    "globals": "^17.13.0",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.1",
    "satori": "^0.56.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
