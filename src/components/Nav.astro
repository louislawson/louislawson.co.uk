---
// The hint and the label of each link sit against each other, with nothing between: compressHTML
// keeps a line break as a space, so the formatter hugs the tags (`><kbd`) and they must stay so.
import type { Section } from "../content/visibility";
import { INSPECT_LABELS } from "./inspect-labels";
import { SECTION_LABELS, sectionHref } from "./section-labels";

interface Props {
  /** The sections this build shows, from visibleSections(): a hidden section has no link. */
  sections: Section[];
}

const { sections } = Astro.props;
// The current section is shown on the home page only, where the sections are.
const home = Astro.url.pathname === "/";
---

<header
  class="nav"
  data-nav
  data-home={home ? "" : undefined}
  data-inspect={INSPECT_LABELS.nav}
  data-inspect-below
>
  <div class="wrap nav__inner">
    <a class="nav__home" href="/">louis<span>.</span>lawson</a>
    {sections.length > 0 && <Fragment>
      <button
        class="nav__menu"
        type="button"
        aria-expanded="false"
        aria-controls="links"
        data-nav-menu
      >
        menu
      </button>
      <nav class="nav__nav" aria-label="Sections">
        <div class="nav__links" id="links">
          {sections.map(({ id, number }) => <a
            href={sectionHref(id)}
            data-number={number}
            ><kbd class="hint" aria-hidden="true">{number}</kbd
            >{SECTION_LABELS[id]}</a
          >)}
        </div>
      </nav>
    </Fragment>}
    <button
      class="inspect-btn"
      type="button"
      aria-pressed="false"
      data-inspect-toggle
      data-pending
    >
      <kbd class="hint" aria-hidden="true">i</kbd>inspect
    </button>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 30;
    background: color-mix(in srgb, var(--bg) 94%, transparent);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }

  /* The bar is one row at its set height. It wraps to a second row only when its contents cannot
     fit, which is when a visitor's own text spacing (WCAG 1.4.12) makes them wider than the window;
     a bar that kept one row would run past the edge and make the whole page scroll sideways. */
  .nav__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 18px;
    min-height: var(--nav-height);
    padding-block: 4px;
  }

  /* The brand is one line of text; the box around it is a comfortable thumb target, and the bar's
     height does not change. */
  .nav__home {
    display: flex;
    align-items: center;
    min-height: 44px;
    margin-right: auto;
    flex: none;
    font-weight: 700;
    text-decoration: none;
  }

  .nav__home span {
    color: var(--hivis);
  }

  .nav__links {
    display: flex;
    gap: 4px;
  }

  .nav__links a {
    padding: 6px 10px;
    color: var(--dim);
    text-decoration: none;
    white-space: nowrap;
    border: 1px solid transparent;
  }

  .nav__links a:hover,
  .nav__links a[aria-current="location"] {
    color: var(--bone);
    border-color: var(--line-strong);
  }

  /* Inside the bar a ring drawn outside the link would be cut off by the scrolling strip. */
  .nav__links a:focus-visible {
    outline-offset: -2px;
  }

  /* The number hints show only while the shortcuts are on. shortcuts-state.js sets that before the
     first paint, so they neither flash nor jump in; with no script, they never show. */
  .hint {
    display: none;
    margin-right: 4px;
    color: var(--hivis);
    font: inherit;
  }

  :global([data-shortcuts="on"]) .hint {
    display: inline;
  }

  /* Inspect mode needs script, so the button is there but unseen until it runs: it keeps its place
     in the bar, and the links do not shift when it appears. */
  .inspect-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 6px 12px;
    color: var(--bone);
    background: transparent;
    border: 1px solid var(--line-strong);
    cursor: pointer;
    transition:
      background-color 160ms var(--ease),
      border-color 160ms var(--ease),
      color 160ms var(--ease);
  }

  .inspect-btn:hover {
    border-color: var(--bone);
  }

  .inspect-btn[aria-pressed="true"] {
    color: var(--bg);
    background: var(--hivis);
    border-color: var(--hivis);
  }

  .inspect-btn[aria-pressed="true"] .hint {
    color: var(--bg);
  }

  .inspect-btn[data-pending] {
    visibility: hidden;
  }

  .nav__menu {
    display: none;
    min-height: 40px;
    padding: 6px 12px;
    color: var(--bone);
    background: none;
    border: 1px solid var(--line-strong);
    cursor: pointer;
  }

  @media (max-width: 900px) {
    /* Below the width where the links collapse, the script is already changing the bar, so the
       button need not hold its place. */
    .inspect-btn[data-pending] {
      display: none;
    }

    .nav__inner {
      gap: 4px 10px;
    }

    /* Without script the links stay in the bar and scroll sideways, so the bar is the same height
       when the script collapses them into the menu and nothing below it moves. */
    .nav__nav {
      flex: 1 1 0;
      min-width: 0;
    }

    .nav__home {
      margin-right: 0;
    }

    .nav__links {
      overflow-x: auto;
      scrollbar-width: thin;
    }

    .nav[data-collapsible] .nav__home {
      margin-right: auto;
    }

    /* Collapsed, the links are a dropdown, so the wrapper takes no room in the bar: a zero-height
       strip across it, which the dropdown hangs from. Left in the row it would add a gap, and the
       bar, now with the inspect button too, would run out of width on a narrow phone. */
    .nav[data-collapsible] .nav__nav {
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      height: 0;
    }

    .nav[data-collapsible] .nav__menu {
      display: inline-flex;
      align-items: center;
    }

    .nav[data-collapsible] .nav__links {
      display: none;
      position: absolute;
      top: 0;
      right: 0;
      left: 0;
      flex-direction: column;
      gap: 0;
      padding: 8px var(--gutter) 14px;
      overflow: visible;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
    }

    .nav[data-collapsible][data-open] .nav__links {
      display: flex;
    }

    .nav[data-collapsible] .nav__links a {
      padding: 12px 0;
      border: 0;
      border-bottom: 1px solid var(--line);
    }
  }

  /* On a narrow phone the brand, the menu and the inspect button fill the bar, and the button's
     name matters more than its key. Only here does the i hint go; the key itself still works and
     the button still says so to a screen reader (aria-keyshortcuts). */
  @media (max-width: 400px) {
    :global([data-shortcuts]) .inspect-btn .hint {
      display: none;
    }
  }

  /* At 320 px (a 1280 px window at 400 % zoom) the brand, the menu and the inspect button are 272 px
     wide where the text is drawn narrowest and 282 px where it is drawn widest (Linux), in a 288 px
     row. With two 10 px gaps they did not fit and the last one wrapped to a second row. A 6 px gap
     and 8 px instead of 12 px beside the words of each button fit them in one row on both, with
     room to spare. From 360 px the row is wide enough and none of this applies. A visitor's own
     text spacing still makes them wider than the row, and then the bar wraps. */
  @media (max-width: 359px) {
    .nav__inner {
      gap: 4px 6px;
    }

    .nav__menu,
    .inspect-btn {
      padding-inline: 8px;
    }
  }
</style>

<script>
  import { trackBarHeight } from "../scripts/bar-height";
  import {
    onHeightChange,
    onKeydown,
    onShortcutsChange,
    scrollSettled,
  } from "../scripts/dom";
  import { initNav } from "../scripts/nav";

  const header = document.querySelector<HTMLElement>("[data-nav]");
  // The page scrolls to a link or a focused control with room for the bar as it is drawn.
  if (header) {
    const root = document.documentElement;
    trackBarHeight({
      setHeight: (height) => root.style.setProperty("--nav-bar", `${height}px`),
      onChange: (listener) => onHeightChange(header, listener),
      settled: scrollSettled,
      scrollPadding: () => parseFloat(getComputedStyle(root).scrollPaddingTop),
      landing: () => {
        // :target is the element the address names, found without reading the address.
        const section = document.querySelector<HTMLElement>(":target");
        return section
          ? {
              top: () => section.getBoundingClientRect().top,
              scrollInto: () => section.scrollIntoView(),
            }
          : null;
      },
    });
  }
  const menu = header?.querySelector<HTMLButtonElement>("[data-nav-menu]");
  if (header && menu) {
    const links = [
      ...header.querySelectorAll<HTMLAnchorElement>("a[data-number]"),
    ].map((element) => ({
      number: Number(element.dataset.number),
      element,
      section: document.getElementById(new URL(element.href).hash.slice(1)),
    }));
    const root = document.documentElement;

    initNav({
      nav: header,
      menu,
      links,
      root,
      home: header.hasAttribute("data-home"),
      viewportHeight: () => window.innerHeight,
      // At the end of a page that scrolls, to within a pixel or two of rounding.
      atBottom: () => {
        const page = document.documentElement;
        return (
          page.scrollHeight > window.innerHeight + 2 &&
          window.scrollY + window.innerHeight >= page.scrollHeight - 2
        );
      },
      onKeydown,
      onViewportChange: (listener) => {
        let queued = false;
        const queue = () => {
          if (queued) return;
          queued = true;
          requestAnimationFrame(() => {
            queued = false;
            listener();
          });
        };
        window.addEventListener("scroll", queue, { passive: true });
        window.addEventListener("resize", queue);
        window.addEventListener("orientationchange", queue);
      },
      // The same width as the media query in this component's style: a media query cannot read
      // the token, and the two have to change together.
      onBreakpointChange: (listener) =>
        window
          .matchMedia("(max-width: 900px)")
          .addEventListener("change", listener),
      onOutsidePress: (listener) =>
        document.addEventListener("pointerdown", (event) => {
          if (!header.contains(event.target as Node)) listener();
        }),
      onShortcutsChange,
    });
  }
</script>
