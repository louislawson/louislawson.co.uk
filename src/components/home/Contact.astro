---
// The email's two halves, the buttons' labels and their arrows hug their tags: compressHTML keeps a
// line break as a space, which would show as a gap after the @ or before an arrow.
import { site, type DeployContext } from "../../config/site";
import {
  renderDecision,
  type Section as SectionInfo,
  type VisibleProfile,
} from "../../content/visibility";
import Icon from "../Icon.astro";
import { INSPECT_LABELS } from "../inspect-labels";
import Placeholder from "../Placeholder.astro";
import { SECTION_INTROS } from "./section-intros";
import Section from "./Section.astro";

interface Props {
  /**
   * What the section reads from the profile, from getSiteContent(). Production has already left
   * out a placeholder and an availability statement that has expired; this leaves out whatever is
   * still missing, so a value that is not there is no row and no button.
   */
  profile: Pick<
    VisibleProfile,
    "email" | "links" | "cv" | "availability" | "region"
  >;
  /** The sections this build shows, from visibleSections(). */
  sections: SectionInfo[];
  /** Defaults to the deploy context of this build. */
  context?: DeployContext;
}

const { profile, sections, context = site.deployContext } = Astro.props;
const { email, links, cv, availability, region } = profile;

// A section that visibleSections() leaves out is not rendered, so the nav and the page agree.
const shown = sections.some((section) => section.id === "contact");

// A value is shown, hatched where a preview has a placeholder, or left out.
const decide = (value: string | undefined) =>
  value === undefined ? "omit" : renderDecision(value, context);

const emailDecision = decide(email);

// The line may break after the @, so a long address wraps at a sensible place on a phone. A value
// that is no address stops the build: the schema has already checked a real one.
let local = "";
let domain = "";
if (email !== undefined && emailDecision === "show") {
  const at = email.lastIndexOf("@");
  if (at < 1) {
    throw new Error(`The email "${email}" is not an address: it has no @`);
  }
  local = email.slice(0, at);
  domain = email.slice(at + 1);
}

// Each value is decided once, and what is left out is gone before the template.
const external = [
  { name: "linkedin", value: links.linkedin },
  { name: "github", value: links.github },
].flatMap(({ name, value }) => {
  const decision = decide(value);
  return value === undefined || decision === "omit"
    ? []
    : [{ name, value, decision }];
});

const cvDecision = decide(cv);
const hasButtons = external.length > 0 || cvDecision !== "omit";

// An availability statement is true until its end date. While that date is a placeholder
// production leaves the statement out, as visibleProfile() does, and a preview shows the date
// hatched beside a real text so the missing date is found. A placeholder text stands for both.
const availabilityText = availability?.text;
const availabilityUntil = availability?.until;
const untilDecision = decide(availabilityUntil);
const textDecision = decide(availabilityText);

interface Fact {
  label: string;
  value: string;
  /** The end date to hatch beside a real value, when it is a placeholder. */
  until?: string;
}
const facts: Fact[] = [
  availabilityText !== undefined &&
  untilDecision !== "omit" &&
  textDecision !== "omit"
    ? {
        label: "availability",
        value: availabilityText,
        ...(textDecision === "show" &&
        untilDecision === "hatch" &&
        availabilityUntil !== undefined
          ? { until: availabilityUntil }
          : {}),
      }
    : undefined,
  region !== undefined && decide(region) !== "omit"
    ? { label: "based in", value: region }
    : undefined,
].filter((fact): fact is Fact => fact !== undefined);
---

{shown && <Section
  id="contact"
  title="contact"
  intro={SECTION_INTROS.contact}
  inspect={INSPECT_LABELS.contact}
>
  {emailDecision === "show" && <a class="mail" href={`mailto:${email}`}
    >{local}@<wbr />{domain}</a
  >}
  {email !== undefined && emailDecision === "hatch" && <span class="mail"
    ><Placeholder value={email} context={context}
  /></span>}
  {hasButtons && <div class="contact__btns">
    {external.map(({ name, value, decision }) =>
      decision === "show" ? (
        <a class="btn" href={value}>{name}<Icon name="external" size={14} /></a>
      ) : (
        <span class="btn"><Placeholder value={value} context={context} /></span>
      ),
    )}
    {cvDecision === "show" && <a class="btn btn--hv" href={cv} download
      >download cv<Icon name="download" size={14}
    /></a>}
    {cvDecision === "hatch" && <span class="btn" aria-disabled="true"
      >cv not added yet</span
    >}
  </div>}
  {facts.length > 0 && <dl class="facts">
    {facts.map(({ label, value, until }) => <div>
      <dt>{label}</dt>
      <dd>
        <Placeholder value={value} context={context} />{until !== undefined &&
          " "}{until !== undefined && (
          <Placeholder value={until} context={context} />
        )}
      </dd>
    </div>)}
  </dl>}
</Section>}

<style>
  .mail {
    display: inline-block;
    margin-top: 2rem;
    font-size: clamp(1.15rem, 0.4rem + 3.8vw, 4.2rem);
    font-weight: 750;
    line-height: 1.15;
    letter-spacing: -0.04em;
    text-decoration: none;
    border-bottom: 2px solid var(--hivis);
  }

  /* The prompt is decoration: the slash gives it no name, so a screen reader reads the address. */
  .mail::before {
    content: "$ mail " / "";
    font-size: 0.4em;
    font-weight: 400;
    color: var(--dim);
    letter-spacing: 0;
    vertical-align: middle;
  }

  .mail:hover {
    color: var(--hivis);
  }

  .contact__btns {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 2rem;
  }

  /* A button with a placeholder in it is not an action, so it neither points nor lights on hover. */
  .contact__btns span.btn:not([aria-disabled]) {
    cursor: default;
  }

  .contact__btns span.btn:not([aria-disabled]):hover {
    border-color: var(--line-strong);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem var(--col-gap);
    max-width: 760px;
    margin: 2.25rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .facts dt {
    color: var(--dim);
  }

  .facts dd {
    margin: 0.2rem 0 0;
  }

  @media (max-width: 520px) {
    .facts {
      grid-template-columns: 1fr;
    }
  }
</style>
