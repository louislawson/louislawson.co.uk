---
// The caption's words and the intro hug their tags: compressHTML keeps a line break as a space.
// The name is lower-cased by the style, never in code, so a placeholder name is still one.
import { site, type DeployContext } from "../../config/site";
import type { Profile } from "../../content/schema";
import {
  garageShown,
  renderDecision,
  type Section as SectionInfo,
} from "../../content/visibility";
import { placeholderDither } from "../../garage/dither";
import type { GaragePhoto } from "../../garage/photos";
import { isPlaceholder, placeholderHint } from "../../content/todo";
import { FIRST_TICK, frame } from "../../scripts/wheel";
import { INSPECT_LABELS } from "../inspect-labels";
import Placeholder from "../Placeholder.astro";
import { SECTION_INTROS } from "./section-intros";
import Section from "./Section.astro";

interface Props {
  /** The sentence beside the wheel. Production leaves it out while it is a placeholder. */
  garageIntro?: string | undefined;
  /** The entries this build shows, from getSiteContent(). */
  garage: Profile["garage"];
  /**
   * What the page makes of each entry's photo, in the order of `garage`: its dither and the address
   * of its optimised copy, or nothing for a placeholder photo (see src/garage/photos.ts).
   */
  photos?: readonly (GaragePhoto | undefined)[];
  /** The sections this build shows, from visibleSections(). */
  sections: SectionInfo[];
  /** Defaults to the deploy context of this build. */
  context?: DeployContext;
}

const {
  garageIntro,
  garage,
  photos = [],
  sections,
  context = site.deployContext,
} = Astro.props;

// A section that visibleSections() leaves out is not rendered, so the nav and the page agree.
const shown = garageShown(garage, sections);

// The first frame is drawn here, at build, so a page with no script or with reduced motion has a
// still wheel. The script carries on from the tick after it. A section that is not shown draws none.
const firstFrame = shown ? frame(FIRST_TICK) : "";

// Each card's photo is one of three things. A real photo is a link to the optimised photo that
// holds its dither. A placeholder photo is, on a preview, a designed empty state: a stand-in dither
// with the hatched placeholder over it, so it is easy to find. Production never reaches that (it
// leaves out an entry whose photo is a placeholder), but if it did the frame is empty and hidden.
// Anything else, a photo that has not been prepared or a string that is not a placeholder, is a
// mistake that stops the build: no card goes blank.
type Entry = Profile["garage"][number];
type Card =
  | { kind: "photo"; entry: Entry; photo: GaragePhoto; alt: string }
  | { kind: "empty"; entry: Entry; photo: string; standIn: string }
  | { kind: "bare"; entry: Entry };

const cards: Card[] = shown
  ? garage.map((entry, index): Card => {
      const photo = photos[index];
      if (photo !== undefined) {
        const alt = isPlaceholder(entry.alt)
          ? `Placeholder: ${placeholderHint(entry.alt)}`
          : entry.alt;
        return { kind: "photo", entry, photo, alt };
      }
      if (typeof entry.photo !== "string" || !isPlaceholder(entry.photo)) {
        throw new Error(
          `The photo for "${entry.name}" was not prepared: give <Garage> its dither and address`,
        );
      }
      return renderDecision(entry.photo, context) === "hatch"
        ? {
            kind: "empty",
            entry,
            photo: entry.photo,
            standIn: placeholderDither(index + 1),
          }
        : { kind: "bare", entry };
    })
  : [];
---

{shown && <Section
  id="garage"
  title="garage"
  intro={SECTION_INTROS.garage}
  inspect={INSPECT_LABELS.garage}
>
  <figure class="garage-wheel">
    <pre data-wheel aria-hidden="true">{firstFrame}</pre>
    <figcaption>
      <b>fig.01 · wheel.</b
      >{garageIntro !== undefined && " "}{garageIntro !== undefined && (
        <Placeholder value={garageIntro} context={context} />
      )}
    </figcaption>
  </figure>
  <div class="garage">
    {cards.map((card) => <figure class="gcard">
      {card.kind === "photo" ? (
        <a
          class="gcard__photo"
          href={card.photo.href}
          aria-label={card.alt}
          data-photo
          ><pre aria-hidden="true">{card.photo.dither}</pre></a
        >
      ) : card.kind === "empty" ? (
        <div class="gcard__photo gcard__photo--empty">
          <pre aria-hidden="true">{card.standIn}</pre>
          <span class="gcard__label"
            ><Placeholder value={card.photo} context={context}
          /></span>
        </div>
      ) : (
        <div class="gcard__photo" aria-hidden="true"></div>
      )}
      <figcaption>
        <h3><Placeholder value={card.entry.name} context={context} /></h3>
        <p><Placeholder value={card.entry.note} context={context} /></p>
        <small
          ><Placeholder value={card.entry.caption} context={context}
        /></small>
      </figcaption>
    </figure>)}
  </div>
</Section>}

<style>
  .garage-wheel {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1rem var(--col-gap);
    align-items: center;
    margin: var(--col-gap) 0;
    border: 1px solid var(--line);
    background: var(--panel);
  }

  .garage-wheel pre {
    grid-column: 1 / span 5;
    margin: 0;
    padding: 14px;
    font-family: var(--mono);
    font-variation-settings: "wdth" 75;
    font-size: clamp(6px, 0.55vw, 9px);
    line-height: 1.12;
    color: var(--bone);
    overflow: hidden;
    text-align: center;
  }

  .garage-wheel figcaption {
    grid-column: 6 / span 6;
    color: var(--dim);
  }

  .garage-wheel figcaption b {
    color: var(--bone);
    font-weight: 600;
  }

  .garage {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--col-gap);
  }

  .gcard {
    margin: 0;
    border: 1px solid var(--line);
    background: var(--panel);
  }

  .gcard__photo {
    position: relative;
    display: block;
    container-type: inline-size;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    color: var(--dim);
    text-align: center;
    border-bottom: 1px solid var(--line);
  }

  /* The dither is 72 columns by 26 rows. A glyph of this face at width 75 is 0.6em wide, so a font
     size of the card's width over 72 x 0.6 makes the columns fill it, and a line height of 1.25 makes
     the rows fill the 4 : 3 box (a row is then 2.08 times as tall as a column is wide, the 2 : 1 the
     grid's shape assumes). */
  .gcard__photo pre {
    margin: 0;
    font-family: var(--mono);
    font-variation-settings: "wdth" 75;
    font-size: calc(100cqw / 43.2);
    line-height: 1.25;
    color: var(--dim);
  }

  .gcard__photo--empty pre {
    opacity: 0.55;
  }

  .gcard__label {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 14px;
  }

  /* The full-colour photo the script puts over the dither, once it is asked for. It is made in the
     browser, so the component's scoped styles do not reach it. */
  .gcard__photo :global(img) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Solid, so a photo with transparent parts does not show the dither through it. */
    background: var(--panel);
  }

  .gcard__photo :global(img[hidden]) {
    display: none;
  }

  .gcard figcaption {
    padding: 14px 16px 16px;
  }

  .gcard h3 {
    font-weight: 700;
    font-size: 1.1rem;
    text-transform: lowercase;
  }

  .gcard p {
    margin-top: 0.4rem;
    color: var(--bone);
  }

  .gcard small {
    display: block;
    margin-top: 0.6rem;
    color: var(--dim);
    font-size: 0.8rem;
  }

  @media (max-width: 900px) {
    .garage {
      grid-template-columns: 1fr;
      max-width: 560px;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .gcard__photo :global(img) {
      animation: gcard-photo-in 160ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    @keyframes gcard-photo-in {
      from {
        opacity: 0;
      }
    }
  }

  @media (max-width: 860px) {
    .garage-wheel pre,
    .garage-wheel figcaption {
      grid-column: 1 / -1;
    }

    .garage-wheel figcaption {
      padding: 0 14px 14px;
    }

    .garage-wheel pre {
      font-size: clamp(6px, 1.8vw, 9px);
    }
  }
</style>

<script>
  import {
    INITIAL_SWAP,
    swapStep,
    type SwapEvent,
    type SwapState,
  } from "../../scripts/photo-swap";
  import { initWheel } from "../../scripts/wheel";

  // Each card's photo is a link that holds the dither. The rules in photo-swap.ts decide when the
  // full-colour photo is wanted; this makes its image then, and only then, so the page loads no
  // photo until one is asked for. The image is the link's own address, with the link's name as alt.
  const photoCards: {
    link: HTMLAnchorElement;
    feed: (event: SwapEvent, original?: Event) => void;
  }[] = [];

  for (const link of document.querySelectorAll<HTMLAnchorElement>(
    "[data-photo]",
  )) {
    let state: SwapState = INITIAL_SWAP;
    let image: HTMLImageElement | undefined;
    // What to do is decided by the rules in photo-swap.ts: when the image is made, when it covers
    // the dither (only once it has loaded, so the card is never blank), and when a failed one is
    // tried again. This does it.
    const feed = (event: SwapEvent, original?: Event) => {
      const step = swapStep(state, event);
      state = step.state;
      if (step.preventDefault) original?.preventDefault();
      if (step.load) {
        const created = document.createElement("img");
        image = created;
        created.hidden = true;
        created.src = link.href;
        created.alt = link.getAttribute("aria-label") ?? "";
        // An image that has been replaced says nothing more. A photo that fails to load leaves the
        // dither as it was, and the link still opens it.
        created.addEventListener("load", () => {
          if (image === created) feed({ type: "photoload" });
        });
        created.addEventListener("error", () => {
          created.remove();
          if (image === created) feed({ type: "photoerror" });
        });
        link.append(created);
      }
      if (image) image.hidden = !step.visible;
    };
    photoCards.push({ link, feed });
    for (const type of [
      "pointerenter",
      "pointerleave",
      "pointerdown",
      "pointercancel",
    ] as const) {
      link.addEventListener(type, (event) =>
        feed({ type, pointerType: event.pointerType }),
      );
    }
    for (const type of ["focus", "blur"] as const) {
      link.addEventListener(type, (event) => feed({ type }, event));
    }
    link.addEventListener("click", (event) =>
      feed(
        { type: "click", pointerType: (event as PointerEvent).pointerType },
        event,
      ),
    );
  }

  // One listener each for all the cards. The keyboard being used, and a press that ends anywhere
  // but on a card, end what a touch left behind: a pinned photo is let go, and a tap that is really
  // a scroll (which ends as a cancel, not a release) does not release it.
  document.addEventListener("keydown", () => {
    for (const card of photoCards) card.feed({ type: "keydown" });
  });
  document.addEventListener("pointerup", (event) => {
    for (const card of photoCards) {
      if (!card.link.contains(event.target as Node)) {
        card.feed({ type: "outside" });
      }
    }
  });

  const pre = document.querySelector<HTMLElement>("[data-wheel]");

  if (pre) {
    initWheel({
      reducedMotion: () =>
        matchMedia("(prefers-reduced-motion: reduce)").matches,
      tabHidden: () => document.hidden,
      watchOnScreen: (listener) => {
        // A browser that cannot say when the wheel is on screen never reports it, and the wheel
        // stays still.
        if (typeof IntersectionObserver === "undefined") return;
        new IntersectionObserver((entries) => {
          const latest = entries[entries.length - 1];
          if (latest) listener(latest.isIntersecting);
        }).observe(pre);
      },
      watchTab: (listener) =>
        document.addEventListener("visibilitychange", listener),
      requestFrame: (callback) => requestAnimationFrame(callback),
      cancelFrame: (handle) => cancelAnimationFrame(handle),
      draw: (text) => {
        pre.textContent = text;
      },
    });
  }
</script>
