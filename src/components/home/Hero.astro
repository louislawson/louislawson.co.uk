---
// The text hugs its tags (`><Placeholder`, `<Icon … />`): compressHTML keeps a line break as a
// space, and none may appear inside a paragraph or before an action's arrow.
import { site, type DeployContext } from "../../config/site";
import {
  renderDecision,
  type Section,
  type VisibleProfile,
} from "../../content/visibility";
import { INSPECT_LABELS } from "../inspect-labels";
import Icon from "../Icon.astro";
import Placeholder from "../Placeholder.astro";

interface Props {
  /** What the hero reads from the profile. Production passes a placeholder as undefined. */
  profile: Pick<VisibleProfile, "roleLine" | "intro" | "careerLine">;
  /** The sections this build shows, from visibleSections(): an action is linked only to one. */
  sections: Section[];
  /** Defaults to the deploy context of this build. */
  context?: DeployContext;
}

const { profile, sections, context = site.deployContext } = Astro.props;

// A paragraph with nothing to show is left out, not rendered empty.
const shown = (value: string | undefined): value is string =>
  value !== undefined && renderDecision(value, context) !== "omit";
const { roleLine, intro, careerLine } = profile;

const hasSection = (id: Section["id"]) =>
  sections.some((section) => section.id === id);
const seeProjects = hasSection("projects");
const getInTouch = hasSection("contact");
---

<section class="wrap hero" aria-labelledby="name">
  <div class="hero__copy">
    <h1 class="hero__name" id="name" data-inspect={INSPECT_LABELS.hero}>
      Louis <br />Lawson<span class="caret" aria-hidden="true"></span>
    </h1>
    {shown(roleLine) && <p class="hero__role">
      <Placeholder value={roleLine} context={context} />
    </p>}
    {shown(intro) && <p class="hero__intro">
      <Placeholder value={intro} context={context} />
    </p>}
    {shown(careerLine) && <p class="hero__career">
      <Placeholder value={careerLine} context={context} />
    </p>}
    {(seeProjects || getInTouch) && <div class="hero__actions">
      {seeProjects && <a class="btn btn--hv" href="#projects"
        >see projects<Icon name="arrow" size={16}
      /></a>}
      {getInTouch && <a class="btn" href="#contact">get in touch</a>}
    </div>}
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 2.5rem var(--col-gap);
    align-items: center;
    padding-block: clamp(3rem, 7vw, 6rem) clamp(3rem, 6vw, 5rem);
    border-bottom: 1px solid var(--line);
  }

  .hero__copy {
    grid-column: 1 / span 7;
  }

  .hero__name {
    font-size: clamp(2.9rem, 1rem + 7vw, 7.4rem);
    font-stretch: 100%;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.92;
  }

  /* A block caret after the name: the one hi-vis mark in the first viewport that is not an action. */
  .caret {
    display: inline-block;
    width: 0.5em;
    height: 0.82em;
    margin-left: 0.06em;
    vertical-align: -0.06em;
    background: var(--hivis);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  /* Still, and lit: the global reduced-motion rule would only cut the blink short. */
  @media (prefers-reduced-motion: reduce) {
    .caret {
      animation: none;
    }
  }

  .hero__role {
    margin-top: 1.75rem;
    color: var(--bone);
    font-size: clamp(1.05rem, 0.95rem + 0.5vw, 1.35rem);
    font-weight: 600;
  }

  .hero__intro {
    max-width: 56ch;
    margin-top: 0.9rem;
    color: var(--bone);
  }

  .hero__career {
    margin-top: 0.7rem;
    color: var(--dim);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 2rem;
  }

  @media (max-width: 960px) {
    .hero__copy {
      grid-column: 1 / -1;
    }
  }
</style>
