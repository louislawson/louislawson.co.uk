---
// Text and a component sit against each other on one line (`<Placeholder … /> · <Placeholder … />`):
// compressHTML keeps a line break as a space, and the meta line is " · " between its halves only.
// The link's name hugs its tags for the same reason: a space inside it would be part of the name.
import { site, type DeployContext } from "../../config/site";
import type { Project } from "../../content/schema";
import type { Section as SectionInfo } from "../../content/visibility";
import Icon from "../Icon.astro";
import { INSPECT_LABELS } from "../inspect-labels";
import Placeholder from "../Placeholder.astro";
import {
  countLabel,
  featuredFirst,
  metaParts,
  projectLayout,
  projectPath,
  runSheetLinkName,
} from "./project-display";
import { SECTION_INTROS } from "./section-intros";
import Section from "./Section.astro";
import Status from "./Status.astro";

interface Props {
  /**
   * The projects this build shows, from getSiteContent(). The section puts them in its own order.
   * Each `id` is the file name, which is also the address of the project's page.
   */
  projects: { id: string; data: Project }[];
  /** The sections this build shows, from visibleSections(). */
  sections: SectionInfo[];
  /** Defaults to the deploy context of this build. */
  context?: DeployContext;
}

const { projects: given, sections, context = site.deployContext } = Astro.props;

// The featured run leads the list, then the rest by `order`.
const projects = featuredFirst(given);

// A section that visibleSections() leaves out is not rendered, so the nav and the page agree.
const shown =
  projects.length > 0 && sections.some((section) => section.id === "projects");
const layout = projectLayout(projects.length);
---

{shown && <Section
  id="projects"
  title="projects"
  intro={SECTION_INTROS.projects}
  inspect={INSPECT_LABELS.projects}
  count={countLabel(projects.length)}
>
  <div class={`runs runs--${layout}`}>
    {projects.map(({ id, data }) => {
      const { lead, period } = metaParts(data);
      // One link to the project's page covers the whole entry, and is last in it.
      const hit = { href: projectPath(id), name: runSheetLinkName(data) };
      return layout === "strip" ? (
        <article class="run run--strip">
          <div class="run__line">
            <span class="run__code">{data.code}</span>
            <h3 class="run__title">
              <Placeholder value={data.title} context={context} />
            </h3>
            <div class="run__aside">
              <span class="leader" aria-hidden="true"></span>
              {data.featured && <span class="tag">featured</span>}
              <Status status={data.status} context={context} />
            </div>
          </div>
          <p class="run__meta">
            <Placeholder value={lead} context={context} /> ·
            <Placeholder value={period} context={context} />
          </p>
          <div class="run__sheet">
            <div>
              <h4>setup</h4>
              <p><Placeholder value={data.setup} context={context} /></p>
            </div>
            <div>
              <h4>change</h4>
              <p><Placeholder value={data.change} context={context} /></p>
            </div>
            <div class="res">
              <h4>result</h4>
              <p><Placeholder value={data.result} context={context} /></p>
            </div>
          </div>
          <span class="run__more" aria-hidden="true"
            >read the run sheet <Icon name="arrow" size={16}
          /></span>
          <a class="hit" href={hit.href}><span class="vh">{hit.name}</span></a>
        </article>
      ) : (
        <article class="run run--row">
          <span class="run__code">{data.code}</span>
          <div class="run__name">
            <h3 class="run__title">
              <Placeholder value={data.title} context={context} />
            </h3>
            {data.featured && <span class="tag">featured</span>}
          </div>
          <span class="headline"
            ><Placeholder value={data.headline} context={context}
          /></span>
          <Status status={data.status} context={context} />
          <span class="arr"><Icon name="arrow" size={16} /></span>
          <a class="hit" href={hit.href}><span class="vh">{hit.name}</span></a>
        </article>
      );
    })}
  </div>
</Section>}

<style>
  .run__code {
    color: var(--hivis);
  }

  /* The link over the whole entry, so the entry is one target and the keyboard focus ring (the
     global one on :focus-visible) goes round all of it. */
  .hit {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* Strips: the run sheet in full. */
  .run--strip {
    position: relative;
    padding-block: 2rem 2.2rem;
    border-bottom: 1px solid var(--line);
  }

  .run__line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 12px;
  }

  .run--strip .run__title {
    font-size: clamp(1.25rem, 1rem + 1vw, 1.9rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    transition: color 140ms var(--ease);
  }

  /* Under the pointer, where there is one (a tap would leave a touch screen lit), or under the
     keyboard focus (a click on the link would too, and it is leaving the page). */
  @media (hover: hover) {
    .run--strip:hover .run__title {
      color: var(--hivis);
    }
  }

  .run--strip:has(:focus-visible) .run__title {
    color: var(--hivis);
  }

  /* The leader, the tag and the status are one piece, so when the line is too short for the title
     and all three they wrap as one, and the dotted line never trails the title alone. */
  .run__aside {
    display: flex;
    flex: 1 1 auto;
    align-items: baseline;
    gap: 12px;
  }

  /* The dotted line from the title to the tag and the status. */
  .leader {
    flex: 1;
    min-width: 2rem;
    border-bottom: 1px dotted var(--line-strong);
    transform: translateY(-0.3em);
  }

  .run__meta {
    margin-top: 0.4rem;
    color: var(--dim);
  }

  .run__sheet {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--col-gap);
    margin-top: 1.4rem;
  }

  .run__sheet h4 {
    margin-bottom: 0.35rem;
    color: var(--dim);
    font-weight: 500;
  }

  /* The prompts are decoration: the second line gives them an empty alt text, so a screen reader
     reads the heading as "setup", and a browser without that form keeps the first. */
  .run__sheet h4::before {
    content: "$ ";
    content: "$ " / "";
    color: var(--hivis);
  }

  .run__sheet .res p {
    color: var(--bone);
    font-weight: 700;
  }

  .run__sheet .res h4::before {
    content: "> ";
    content: "> " / "";
  }

  /* The line the link ends a strip with. It is for the eye: the link has its own name. */
  .run__more {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    margin-top: 1.3rem;
    color: var(--hivis);
  }

  @media (max-width: 760px) {
    .run__sheet {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    /* On a phone the status wraps under the title, and a dotted line that trails the title and
       leads nowhere is clutter. */
    .leader {
      display: none;
    }
  }

  /* Rows: the compact list, from four projects. */
  .run--row {
    position: relative;
    display: grid;
    grid-template-columns: 3.6rem minmax(0, 1.5fr) minmax(0, 1fr) 9.5rem 1.5rem;
    gap: 14px;
    align-items: center;
    padding-block: 1rem;
    border-bottom: 1px solid var(--line);
    transition: background-color 140ms var(--ease);
  }

  /* The marker that arrives in the gutter under the pointer or the focus. */
  .run--row::before {
    content: "";
    position: absolute;
    top: 50%;
    left: -14px;
    width: 6px;
    height: 6px;
    background: var(--hivis);
    transform: translateY(-50%) scale(0);
    transition: transform 160ms var(--ease);
  }

  @media (hover: hover) {
    .run--row:hover {
      background: var(--panel);
    }

    .run--row:hover::before {
      transform: translateY(-50%) scale(1);
    }
  }

  .run--row:has(:focus-visible) {
    background: var(--panel);
  }

  .run--row:has(:focus-visible)::before {
    transform: translateY(-50%) scale(1);
  }

  .arr {
    display: inline-flex;
    color: var(--hivis);
  }

  /* The title and the featured tag side by side, the tag outside the heading. */
  .run__name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
  }

  .run--row .run__title {
    font-size: clamp(1rem, 0.95rem + 0.4vw, 1.2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .run--row .headline {
    color: var(--dim);
  }

  @media (max-width: 760px) {
    .run--row {
      grid-template-columns: 3rem minmax(0, 1fr) 1.5rem;
      row-gap: 3px;
    }

    .arr {
      grid-column: 3;
      grid-row: 1;
    }

    /* The cell holds a status or a placeholder for one: both go under the title. */
    .run--row .headline,
    .run--row :global(.run__status) {
      grid-column: 2;
    }
  }
</style>
