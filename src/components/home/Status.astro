---
// A project's status: a square marker and the word, in a cell that the layout places. A
// placeholder takes the same cell, hatched, so the layout treats the two alike.
import { site, type DeployContext } from "../../config/site";
import { isPlaceholder } from "../../content/todo";
import Placeholder from "../Placeholder.astro";
import { statusLabel } from "./project-display";

interface Props {
  /** A status, or a placeholder for one. */
  status: string;
  /** Defaults to the deploy context of this build. */
  context?: DeployContext;
}

const { status, context = site.deployContext } = Astro.props;
---

<span class="run__status">
  {isPlaceholder(status) ? (
    <Placeholder value={status} context={context} />
  ) : (
    <span class={`status status--${status}`}>{statusLabel(status)}</span>
  )}
</span>

<style>
  /* The square marker and the word. Only in service uses green, which is for live state alone. */
  /* One line at the size it is drawn: the cell is as wide as its own text, so the marker and the
     word sit together. Where text at twice the size is wider than its column it breaks, instead of
     running out of the page. */
  .status {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .status::before {
    content: "";
    flex: none;
    width: 8px;
    height: 8px;
    box-sizing: border-box;
  }

  .status--in-service {
    color: var(--ok);
  }

  /* Every marker has a border, and a filled one has a fill as well: forced colours (Windows High
     Contrast) drop a background and keep a border, so a fill alone would vanish. */
  .status--in-service::before {
    background: var(--ok);
    border: 2px solid var(--ok);
  }

  .status--commissioning {
    color: var(--hivis);
  }

  .status--commissioning::before {
    border: 2px solid var(--hivis);
  }

  .status--complete {
    color: var(--bone);
  }

  .status--complete::before {
    background: var(--bone);
    border: 2px solid var(--bone);
  }

  .status--archived {
    color: var(--dim);
  }

  .status--archived::before {
    border: 2px solid var(--dim);
  }
</style>
