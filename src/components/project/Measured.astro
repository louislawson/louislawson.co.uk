---
// The measurements as a before-and-after table, then the tools, and the links that follow them.
// The links' labels and arrows hug their tags: compressHTML keeps a line break as a space, which
// would show as a gap before an arrow.
import { site, type DeployContext } from "../../config/site";
import type { Project } from "../../content/schema";
import { renderDecision } from "../../content/visibility";
import Icon from "../Icon.astro";
import Placeholder from "../Placeholder.astro";
import { measurementRows } from "./measurement-rows";

interface Props {
  /** The project this page is for, from getSiteContent(). */
  project: { data: Project };
  /** Defaults to the deploy context of this build. */
  context?: DeployContext;
}

const { project, context = site.deployContext } = Astro.props;
const { stack, links } = project.data;

// A value is shown, hatched where a preview has a placeholder, or left out. Production has already
// dropped the placeholders in these lists; this keeps a stray one from rendering as an empty cell.
const tools = stack.filter((tool) => renderDecision(tool, context) !== "omit");
const shownLinks = links.flatMap((link) => {
  const label = renderDecision(link.label, context);
  const url = renderDecision(link.url, context);
  if (label === "omit" || url === "omit") return [];
  // A link is a link only when both halves are real. Otherwise it is a button that is not one, and
  // it shows the label, then the address hatched beside it when only the address is missing.
  return [
    {
      ...link,
      real: label === "show" && url === "show",
      labelShown: label === "show",
    },
  ];
});
// A measurement is real or absent, so these need no placeholder handling.
const rows = measurementRows(project.data.measurements);
// The heading says only what the block holds: "measured" promises figures, so a project without
// any is headed "tools".
const heading = rows.length > 0 ? "measured" : "tools";
// Nothing to put in the block, nothing rendered: no heading over an empty list.
const shown = rows.length > 0 || tools.length > 0 || shownLinks.length > 0;
---

{shown && <section class="wrap p-section" aria-labelledby={heading}>
  <div class="p-cols">
    <h2 id={heading}>{heading}</h2>
    <div>
      {rows.length > 0 && <table class="diff">
        <caption class="vh">
          Before and after measurements
        </caption>
        <thead>
          <tr>
            <th scope="col">measure</th>
            <th scope="col">before</th>
            <th scope="col">after</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => <tr>
            <th scope="row">{row.label}</th>
            {row.kind === "change" ? (
              <>
                <td class="before">{row.before}</td>
                <td class="after">{row.after}</td>
              </>
            ) : (
              <td colspan="2">{row.value}</td>
            )}
          </tr>)}
        </tbody>
      </table>}
      {tools.length > 0 && <ul class="stack" aria-label="Tools used">
        {tools.map((tool) => <li>
          <Placeholder value={tool} context={context} />
        </li>)}
      </ul>}
      {shownLinks.length > 0 && <div class="links">
        {shownLinks.map(({ label, url, real, labelShown }) =>
          real ? (
            <a class="btn" href={url}
              >{label}<Icon name="external" size={14}
            /></a>
          ) : (
            <span class="btn"
              ><Placeholder value={label} context={context} />{labelShown &&
                " "}{labelShown && (
                <Placeholder value={url} context={context} />
              )}</span
            >
          ),
        )}
      </div>}
    </div>
  </div>
</section>}

<style>
  .diff {
    width: 100%;
    border: 1px solid var(--line);
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  .diff th,
  .diff td {
    padding: 0.7rem 14px;
    text-align: left;
    font-weight: 400;
    vertical-align: top;
    border-bottom: 1px solid var(--line);
  }

  .diff tbody tr:last-child > * {
    border-bottom: 0;
  }

  .diff thead th {
    color: var(--dim);
    background: var(--panel);
  }

  /* The measure takes the room the two values leave. On a phone the label wraps rather than the
     values. */
  .diff th:first-child {
    width: 40%;
  }

  /* Before is dim and after is bone. The - and + are decoration: the second line gives each an
     empty alt text, so a screen reader hears the column headings, not the signs. */
  .before {
    color: var(--dim);
  }

  .before::before {
    content: "- ";
    content: "- " / "";
  }

  .after {
    color: var(--bone);
    font-weight: 700;
  }

  .after::before {
    content: "+ ";
    content: "+ " / "";
  }

  .diff + .stack {
    margin-top: 1rem;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .stack li {
    padding: 2px 10px;
    color: var(--dim);
    border: 1px solid var(--line-strong);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 1.5rem;
  }

  /* A button with a placeholder in it is not an action, so it neither points nor lights on hover. */
  .links span.btn {
    cursor: default;
  }

  .links span.btn:hover {
    border-color: var(--line-strong);
  }
</style>
