---
// The top of a project's page: the way back, the title, the meta row and the run sheet. The title
// hugs its placeholder: compressHTML keeps a line break as a space, which would show in the heading.
import { site, type DeployContext } from "../../config/site";
import type { Project } from "../../content/schema";
import { metaParts } from "../home/project-display";
import Status from "../home/Status.astro";
import Icon from "../Icon.astro";
import { projectPageLabel } from "../inspect-labels";
import Placeholder from "../Placeholder.astro";

interface Props {
  /** The project this page is for: the collection's entry, as getSiteContent() returns it. */
  project: { id: string; filePath?: string | undefined; data: Project };
  /** Defaults to the deploy context of this build. */
  context?: DeployContext;
}

const { project, context = site.deployContext } = Astro.props;
const { data } = project;
const { lead, period } = metaParts(data);
---

<section class="wrap p-head" aria-labelledby="title">
  <a class="back" href="/#projects"
    ><Icon name="back" size={16} />all projects</a
  >
  <h1 id="title" data-inspect={projectPageLabel(project)}>
    <Placeholder value={data.title} context={context} />
  </h1>
  <p class="p-meta">
    <span class="p-meta__code">{data.code}</span>
    {data.featured && <span class="tag">featured</span>}
    <Status status={data.status} context={context} />
    <span><Placeholder value={period} context={context} /></span>
    <span><Placeholder value={lead} context={context} /></span>
  </p>
  <div class="p-sheet">
    <div>
      <h2>setup</h2>
      <p><Placeholder value={data.setup} context={context} /></p>
    </div>
    <div>
      <h2>change</h2>
      <p><Placeholder value={data.change} context={context} /></p>
    </div>
    <div class="res">
      <h2>result</h2>
      <p><Placeholder value={data.result} context={context} /></p>
    </div>
  </div>
</section>

<style>
  .p-head {
    padding-block: clamp(2rem, 5vw, 4rem) 2rem;
    border-bottom: 1px solid var(--line);
  }

  .back {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    min-height: 44px;
    color: var(--dim);
    text-decoration: none;
  }

  .back:hover,
  .back:focus-visible {
    color: var(--hivis);
  }

  .p-head h1 {
    max-width: 18ch;
    /* Room for the inspect label, which sits above the heading and takes two lines on a phone. */
    margin-top: 2rem;
    font-size: clamp(2.2rem, 1rem + 5vw, 5.6rem);
    font-stretch: 100%;
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.04em;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .p-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    align-items: baseline;
    margin-top: 1rem;
    color: var(--dim);
  }

  .p-meta__code {
    color: var(--hivis);
  }

  .p-sheet {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 2.5rem;
    background: var(--panel);
    border: 1px solid var(--line);
  }

  .p-sheet > div {
    padding: clamp(14px, 2vw, 24px);
  }

  .p-sheet > div + div {
    border-left: 1px solid var(--line);
  }

  .p-sheet h2 {
    color: var(--dim);
    font-size: 0.9rem;
    font-weight: 500;
  }

  /* The prompts are decoration: the second line gives them an empty alt text, so a screen reader
     reads the heading as "setup", and a browser without that form keeps the first. */
  .p-sheet h2::before {
    content: "$ ";
    content: "$ " / "";
    color: var(--hivis);
  }

  .p-sheet .res h2::before {
    content: "> ";
    content: "> " / "";
  }

  .p-sheet p {
    margin-top: 0.5rem;
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.15rem);
  }

  .p-sheet .res p {
    font-weight: 700;
  }

  @media (max-width: 760px) {
    .p-sheet {
      grid-template-columns: 1fr;
    }

    .p-sheet > div + div {
      border-top: 1px solid var(--line);
      border-left: 0;
    }
  }
</style>
