---
// The font comes from the @fontsource package through global.css, with a preload for the Latin
// file. Astro's <Font /> is not used: it writes an inline style, which the site's policy blocks.
import latinFont from "@fontsource-variable/martian-mono/files/martian-mono-latin-wdth-normal.woff2?url";
import Footer from "../components/Footer.astro";
import InspectNote from "../components/InspectNote.astro";
import Nav from "../components/Nav.astro";
import { buildCommitDate } from "../config/last-updated";
import { site } from "../config/site";
import type { Section } from "../content/visibility";
import { metaTags, type PageMeta } from "../seo/meta";
import shortcutsState from "../scripts/shortcuts-state.js?url";
import "../styles/global.css";

interface Props {
  title: string;
  /** The 404 page is served for every missing address, so it has no canonical URL of its own. */
  canonical?: boolean;
  /**
   * The sections this build shows, from visibleSections(), for the navigation. A page passes what
   * getSiteContent() returned, and a page that forgets fails `astro check`.
   */
  sections: Section[];
  /**
   * What a link to the page previews as: its description (left out while there is none) and its
   * card. The home and project pages pass it; the 404 page does not, and has no sharing tags.
   */
  meta?: Pick<PageMeta, "description" | "image" | "imageAlt" | "type">;
}

const { title, canonical = true, sections, meta } = Astro.props;
const canonicalUrl = canonical
  ? new URL(Astro.url.pathname, site.url).href
  : undefined;
const tags = meta
  ? metaTags({ ...meta, title, pathname: Astro.url.pathname }, site.url)
  : [];
// shortcutsState sets <html data-shortcuts> before the first paint, so the number hints do not
// flash. It is a file, as the policy allows no inline code; a classic script in <head>, so it
// blocks rendering and runs before anything shows; and a hashed asset (cached for good, so a repeat
// visit makes no request for it), which a file in public/ would not be: that is revalidated on
// every load, and this one blocks the first paint.
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    {site.noindex && <meta name="robots" content="noindex" />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {tags.map((tag) =>
      tag.attribute === "name" ? (
        <meta name={tag.key} content={tag.content} />
      ) : (
        <meta property={tag.key} content={tag.content} />
      ),
    )}
    <script is:inline src={shortcutsState}></script>
    <link
      rel="preload"
      href={latinFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
    {site.beaconToken && (
      <script
        is:inline
        type="module"
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: site.beaconToken })}
      />
    )}
  </head>
  <body>
    <a class="vh skip" href="#main">Skip to content</a>
    <Nav sections={sections} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer updated={buildCommitDate()} />
    <InspectNote />
  </body>
</html>
