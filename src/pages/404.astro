---
import { INSPECT_LABELS } from "../components/inspect-labels";
import NotFoundLinks from "../components/NotFoundLinks.astro";
import { getSiteContent } from "../content/site-content";
import Base from "../layouts/Base.astro";

// The links are the sections this build shows, so a section left out of production has none here.
const { sections } = await getSiteContent();
---

<Base title="Not found | Louis Lawson" canonical={false} sections={sections}>
  <div class="wrap notfound" data-inspect={INSPECT_LABELS.notFound}>
    <h1>404 · not found</h1>
    <p>There is nothing at this address.</p>
    <NotFoundLinks sections={sections} />
  </div>
</Base>

<style>
  .notfound {
    padding-block: clamp(3rem, 7vw, 6rem) 0;
  }

  /* Inspect mode writes this content's label above it, but the content starts right under the
     sticky bar, which would hide it, and the bar's own label comes first. So in inspect mode only,
     the content moves down: room for the bar's label (up to three lines on a phone), then this
     one. A visitor who has not asked for inspect mode sees the page as it is. */
  :global(body.inspecting) .notfound {
    margin-top: 6rem;
  }

  h1 {
    font-size: clamp(2.2rem, 1rem + 5vw, 5.6rem);
    font-stretch: 100%;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.95;
    text-wrap: balance;
  }

  p {
    margin-block: 1.25rem 2.5rem;
  }
</style>
