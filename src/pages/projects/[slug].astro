---
import type { InferGetStaticPropsType } from "astro";
import { render } from "astro:content";
import Measured from "../../components/project/Measured.astro";
import NextProject from "../../components/project/NextProject.astro";
import ProjectHead from "../../components/project/ProjectHead.astro";
import WriteUp from "../../components/project/WriteUp.astro";
import {
  pageTitle,
  projectPages,
  writeUpKind,
} from "../../components/home/project-display";
import { getSiteContent } from "../../content/site-content";
import Base from "../../layouts/Base.astro";

// One page per project this build shows, from the same list as the home page: production builds the
// real projects, a preview builds every one, and a project that is left out has no page, so its
// address gets the 404 page.
export async function getStaticPaths() {
  const { projects, sections } = await getSiteContent();
  // getStaticPaths runs apart from the page, so what the page needs besides its own project, the
  // sections the navigation lists, travels in the props of every page.
  return projectPages(projects).map((page) => ({
    ...page,
    props: { ...page.props, sections },
  }));
}

// Astro types Astro.props from the name `Props`.
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { project, next, sections } = Astro.props;
const writeUp = writeUpKind(project.body);
// A body that is only a placeholder is hatched, not rendered, and no body has no write-up at all.
const { Content } = await render(project);
---

<Base title={pageTitle(project.data)} sections={sections}>
  <ProjectHead project={project} />
  <Measured project={project} />
  {writeUp.kind === "placeholder" && <WriteUp placeholder={writeUp.text} />}
  {writeUp.kind === "prose" && <WriteUp><Content /></WriteUp>}
  <NextProject next={next} />
</Base>
